<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ include file="/WEB-INF/JSPF/inmo_db-conexion.jspf" %>
<%@ page import="java.sql.*" %>
<%if(session.getAttribute("usuarioId")==null||!"INMOBILIARIA".equals(session.getAttribute("usuarioRol"))){response.sendRedirect("../login.jsp?error=acceso");return;}String tituloPagina="Editar propiedad | Inmoraiz";String id=request.getParameter("id");String error=request.getParameter("error");String titulo="",descripcion="",matricula="",modalidad="",precio="",area="",habitaciones="",banos="";int ciudad=0,tipo=0;try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("SELECT p.* FROM propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria WHERE p.id_propiedad=? AND i.id_usuario=?")){p.setInt(1,Integer.parseInt(id));p.setInt(2,(Integer)session.getAttribute("usuarioId"));try(ResultSet r=p.executeQuery()){if(!r.next()){response.sendError(404);return;}titulo=r.getString("titulo");descripcion=r.getString("descripcion");matricula=r.getString("matricula_inmobiliaria");modalidad=r.getString("modalidad");precio=r.getBigDecimal("precio").toString();area=r.getBigDecimal("area_m2").toString();habitaciones=String.valueOf(r.getInt("habitaciones"));banos=String.valueOf(r.getInt("banos"));ciudad=r.getInt("id_ciudad");tipo=r.getInt("id_tipo");}}}catch(Exception e){response.sendError(500);return;}%>
<!DOCTYPE html><html lang="es"><head><%@include file="/WEB-INF/JSPF/inmo_head.jspf"%></head><body><%@include file="/WEB-INF/JSPF/inmo_navbar.jspf"%><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-9"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-lg-5"><a href="inmobiliaria_propiedades.jsp" class="link-dark">Volver a propiedades</a><h1 class="h3 fw-bold mt-4">Editar propiedad</h1><%if("error".equals(error)){%><div class="alert alert-danger">No fue posible guardar los cambios.</div><%}%><form method="post" action="propiedad_actualizar.jsp"><input type="hidden" name="id" value="<%=id%>"><div class="row g-3"><div class="col-md-8"><label class="form-label">Título</label><input class="form-control" name="titulo" value="<%=titulo%>" required></div><div class="col-md-4"><label class="form-label">Matrícula</label><input class="form-control" name="matricula" value="<%=matricula%>" readonly></div><div class="col-md-4"><label class="form-label">Ciudad</label><select class="form-select" name="id_ciudad" required><%try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("SELECT id_ciudad,nombre FROM ciudad ORDER BY nombre");ResultSet r=p.executeQuery()){while(r.next()){%><option value="<%=r.getInt(1)%>" <%=ciudad==r.getInt(1)?"selected":""%>><%=r.getString(2)%></option><%}}}catch(Exception ignored){}%></select></div><div class="col-md-4"><label class="form-label">Tipo</label><select class="form-select" name="id_tipo" required><%try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("SELECT id_tipo,nombre FROM tipo_propiedad ORDER BY nombre");ResultSet r=p.executeQuery()){while(r.next()){%><option value="<%=r.getInt(1)%>" <%=tipo==r.getInt(1)?"selected":""%>><%=r.getString(2)%></option><%}}}catch(Exception ignored){}%></select></div><div class="col-md-4"><label class="form-label">Modalidad</label><select class="form-select" name="modalidad"><option value="VENTA" <%= "VENTA".equals(modalidad)?"selected":""%>>Venta</option><option value="ARRIENDO" <%= "ARRIENDO".equals(modalidad)?"selected":""%>>Arriendo</option></select></div><div class="col-md-4"><label class="form-label">Precio</label><input class="form-control" name="precio" type="number" value="<%=precio%>" required></div><div class="col-md-4"><label class="form-label">Área m2</label><input class="form-control" name="area_m2" type="number" value="<%=area%>" required></div><div class="col-md-2"><label class="form-label">Habitaciones</label><input class="form-control" name="habitaciones" type="number" value="<%=habitaciones%>" required></div><div class="col-md-2"><label class="form-label">Baños</label><input class="form-control" name="banos" type="number" value="<%=banos%>" required></div><div class="col-12"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" rows="4" required><%=descripcion%></textarea></div><div class="col-12"><button class="btn btn-primary">Guardar cambios</button></div></div></form></div></div></div></div></main><%@include file="/WEB-INF/JSPF/inmo_footer.jspf"%></body></html>


