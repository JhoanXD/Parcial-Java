<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ include file="/WEB-INF/JSPF/inmo_db-conexion.jspf" %>
<%@ page import="java.sql.*" %>
<%if(session.getAttribute("usuarioId")==null||!"INMOBILIARIA".equals(session.getAttribute("usuarioRol"))){response.sendRedirect("../login.jsp?error=acceso");return;}String id=request.getParameter("id");try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("UPDATE propiedad p INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria SET p.titulo=?,p.descripcion=?,p.id_ciudad=?,p.id_tipo=?,p.modalidad=?,p.precio=?,p.area_m2=?,p.habitaciones=?,p.banos=? WHERE p.id_propiedad=? AND i.id_usuario=?")){p.setString(1,request.getParameter("titulo"));p.setString(2,request.getParameter("descripcion"));p.setInt(3,Integer.parseInt(request.getParameter("id_ciudad")));p.setInt(4,Integer.parseInt(request.getParameter("id_tipo")));p.setString(5,request.getParameter("modalidad"));p.setBigDecimal(6,new java.math.BigDecimal(request.getParameter("precio")));p.setBigDecimal(7,new java.math.BigDecimal(request.getParameter("area_m2")));p.setInt(8,Integer.parseInt(request.getParameter("habitaciones")));p.setInt(9,Integer.parseInt(request.getParameter("banos")));p.setInt(10,Integer.parseInt(id));p.setInt(11,(Integer)session.getAttribute("usuarioId"));p.executeUpdate();}}catch(Exception e){response.sendRedirect("propiedad_editar.jsp?id="+id+"&error=error");return;}response.sendRedirect("inmobiliaria_propiedades.jsp?estado=ok");%>

