<%@ include file="/WEB-INF/JSPF/inmo_db-conexion.jspf" %>
<%@ page import="java.sql.*" %>
<% if(session.getAttribute("usuarioId")==null){response.sendRedirect("../login.jsp?error=acceso");return;} String tituloPagina="Mi perfil | Inmoraiz"; String mensaje=null; if("POST".equalsIgnoreCase(request.getMethod())){try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("UPDATE perfil SET nombres=?,apellidos=?,documento=?,telefono=?,direccion=? WHERE id_usuario=?")){p.setString(1,request.getParameter("nombres"));p.setString(2,request.getParameter("apellidos"));p.setString(3,request.getParameter("documento"));p.setString(4,request.getParameter("telefono"));p.setString(5,request.getParameter("direccion"));p.setInt(6,(Integer)session.getAttribute("usuarioId"));p.executeUpdate();mensaje="ok";}}catch(Exception e){mensaje="error";}} String nombres="",apellidos="",documento="",telefono="",direccion="";try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("SELECT nombres,apellidos,documento,telefono,direccion FROM perfil WHERE id_usuario=?")){p.setInt(1,(Integer)session.getAttribute("usuarioId"));try(ResultSet r=p.executeQuery()){if(r.next()){nombres=r.getString(1);apellidos=r.getString(2);documento=r.getString(3);telefono=r.getString(4);direccion=r.getString(5);}}}}catch(Exception ignored){} %>
<!DOCTYPE html><html lang="es"><head><%@ include file="/WEB-INF/JSPF/inmo_head.jspf" %></head><body><%@ include file="/WEB-INF/JSPF/inmo_navbar.jspf" %><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-lg-5"><h1 class="h3 fw-bold">Mi perfil</h1><p class="text-muted">Actualiza tus datos personales.</p><%if("ok".equals(mensaje)){%><div class="alert alert-success">Perfil actualizado.</div><%}else if("error".equals(mensaje)){%><div class="alert alert-danger">No fue posible actualizar el perfil.</div><%}%><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nombres</label><input class="form-control" name="nombres" value="<%=nombres%>" required></div><div class="col-md-6"><label class="form-label">Apellidos</label><input class="form-control" name="apellidos" value="<%=apellidos%>" required></div><div class="col-md-4"><label class="form-label">Documento</label><input class="form-control" name="documento" value="<%=documento%>" required></div><div class="col-md-4"><label class="form-label">Teléfono</label><input class="form-control" name="telefono" value="<%=telefono%>" required></div><div class="col-md-4"><label class="form-label">Dirección</label><input class="form-control" name="direccion" value="<%=direccion%>"></div><div class="col-12"><button class="btn btn-primary">Guardar cambios</button></div></div></form></div></div></div></div></main><%@ include file="/WEB-INF/JSPF/inmo_footer.jspf" %></body></html>


