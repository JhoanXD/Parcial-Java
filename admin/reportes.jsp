<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ include file="/WEB-INF/JSPF/inmo_db-conexion.jspf" %>
<%@ page import="java.sql.*" %>
<%
if (session.getAttribute("usuarioId") == null || !"ADMINISTRADOR".equals(session.getAttribute("usuarioRol"))) { response.sendRedirect("../login.jsp?error=acceso"); return; }
String tituloPagina = "Reportes | Inmoraiz";
%>
<!DOCTYPE html>
<html lang="es">
<head><%@ include file="/WEB-INF/JSPF/inmo_head.jspf" %></head>
<body><%@ include file="/WEB-INF/JSPF/inmo_navbar.jspf" %>
<main class="container py-5"><div class="mb-4"><p class="text-primary fw-semibold mb-1">ADMINISTRADOR</p><h1 class="fw-bold mb-1">Reportes del negocio</h1><p class="text-muted mb-0">Consultas consolidadas de propiedades, citas y solicitudes.</p></div><div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5 fw-bold">Propiedades por ciudad y estado</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Ciudad</th><th>Estado</th><th>Total</th></tr></thead><tbody><% try { Class.forName("com.mysql.cj.jdbc.Driver"); try (Connection conexion = abrirConexion(); PreparedStatement sentencia = conexion.prepareStatement("SELECT c.nombre ciudad, p.estado, COUNT(*) total FROM propiedad p INNER JOIN ciudad c ON c.id_ciudad=p.id_ciudad GROUP BY c.id_ciudad,c.nombre,p.estado HAVING COUNT(*) >= 1 ORDER BY c.nombre,p.estado"); ResultSet datos = sentencia.executeQuery()) { while (datos.next()) { %><tr><td><%= datos.getString("ciudad") %></td><td><%= datos.getString("estado") %></td><td><%= datos.getInt("total") %></td></tr><% } } } catch (Exception exception) { %><tr><td colspan="3" class="text-danger">No disponible</td></tr><% } %></tbody></table></div></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5 fw-bold">Citas por estado</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Estado</th><th>Total</th></tr></thead><tbody><% try { Class.forName("com.mysql.cj.jdbc.Driver"); try (Connection conexion = abrirConexion(); PreparedStatement sentencia = conexion.prepareStatement("SELECT estado, COUNT(*) total FROM cita GROUP BY estado HAVING COUNT(*) >= 1 ORDER BY total DESC"); ResultSet datos = sentencia.executeQuery()) { while (datos.next()) { %><tr><td><%= datos.getString("estado") %></td><td><%= datos.getInt("total") %></td></tr><% } } } catch (Exception exception) { %><tr><td colspan="2" class="text-muted">Aún no hay citas.</td></tr><% } %></tbody></table></div></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5 fw-bold">Solicitudes por inmobiliaria</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Inmobiliaria</th><th>Estado</th><th>Total</th></tr></thead><tbody><% try { Class.forName("com.mysql.cj.jdbc.Driver"); try (Connection conexion = abrirConexion(); PreparedStatement sentencia = conexion.prepareStatement("SELECT i.nombre inmobiliaria, s.estado, COUNT(*) total FROM solicitud s INNER JOIN propiedad p ON p.id_propiedad=s.id_propiedad INNER JOIN inmobiliaria i ON i.id_inmobiliaria=p.id_inmobiliaria GROUP BY i.id_inmobiliaria,i.nombre,s.estado HAVING COUNT(*) >= 1 ORDER BY i.nombre,s.estado"); ResultSet datos = sentencia.executeQuery()) { while (datos.next()) { %><tr><td><%= datos.getString("inmobiliaria") %></td><td><%= datos.getString("estado") %></td><td><%= datos.getInt("total") %></td></tr><% } } } catch (Exception exception) { %><tr><td colspan="3" class="text-danger">No disponible</td></tr><% } %></tbody></table></div></div></div></div></div></main>
<%@ include file="/WEB-INF/JSPF/inmo_footer.jspf" %></body>
</html>


