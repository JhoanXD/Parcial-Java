<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ include file="/WEB-INF/JSPF/inmo_db-conexion.jspf" %>
<%@ page import="java.sql.*" %>
<% if(session.getAttribute("usuarioId")==null||!"ADMINISTRADOR".equals(session.getAttribute("usuarioRol"))){response.sendRedirect("../login.jsp?error=acceso");return;} String tituloPagina="Usuarios y roles | Inmoraiz"; String mensaje=null; if("POST".equalsIgnoreCase(request.getMethod())){try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion()){String accion=request.getParameter("accion");int id=Integer.parseInt(request.getParameter("id_usuario"));if("estado".equals(accion)){try(PreparedStatement p=c.prepareStatement("UPDATE usuario SET estado=? WHERE id_usuario=?")){p.setString(1,request.getParameter("estado"));p.setInt(2,id);p.executeUpdate();}}else{try(PreparedStatement borrar=c.prepareStatement("DELETE FROM usuario_rol WHERE id_usuario=?")){borrar.setInt(1,id);borrar.executeUpdate();}try(PreparedStatement insertar=c.prepareStatement("INSERT INTO usuario_rol(id_usuario,id_rol) VALUES (?,?)")){insertar.setInt(1,id);insertar.setInt(2,Integer.parseInt(request.getParameter("id_rol")));insertar.executeUpdate();}}}mensaje="ok";}catch(Exception e){mensaje="error";}} %>
<!DOCTYPE html><html lang="es"><head><%@ include file="/WEB-INF/JSPF/inmo_head.jspf" %></head><body><%@ include file="/WEB-INF/JSPF/inmo_navbar.jspf" %><main class="container py-5"><div class="mb-4"><p class="text-primary fw-semibold mb-1">ADMINISTRADOR</p><h1 class="fw-bold">Usuarios y roles</h1><p class="text-muted">Activa cuentas y asigna permisos.</p></div><%if("ok".equals(mensaje)){%><div class="alert alert-success">Cambio guardado.</div><%}else if("error".equals(mensaje)){%><div class="alert alert-danger">No fue posible guardar el cambio.</div><%}%><div class="table-responsive card border-0 shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Correo</th><th>Estado</th><th>Roles</th><th>Estado</th><th>Asignar rol</th></tr></thead><tbody><%try{Class.forName("com.mysql.cj.jdbc.Driver");try(Connection c=abrirConexion();PreparedStatement p=c.prepareStatement("SELECT u.id_usuario,u.correo,u.estado,COALESCE(GROUP_CONCAT(r.nombre SEPARATOR ', '),'SIN ROL') roles FROM usuario u LEFT JOIN usuario_rol ur ON ur.id_usuario=u.id_usuario LEFT JOIN rol r ON r.id_rol=ur.id_rol GROUP BY u.id_usuario,u.correo,u.estado ORDER BY u.id_usuario")){try(ResultSet r=p.executeQuery()){while(r.next()){%><tr><td><%=r.getString("correo")%></td><td><%=r.getString("estado")%></td><td><%=r.getString("roles")%></td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="accion" value="estado"><input type="hidden" name="id_usuario" value="<%=r.getInt("id_usuario")%>"><select name="estado" class="form-select form-select-sm"><option value="ACTIVO">Activo</option><option value="INACTIVO">Inactivo</option><option value="BLOQUEADO">Bloqueado</option></select><button class="btn btn-sm btn-outline-primary">Guardar</button></form></td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="accion" value="rol"><input type="hidden" name="id_usuario" value="<%=r.getInt("id_usuario")%>"><select name="id_rol" class="form-select form-select-sm"><option value="1">Administrador</option><option value="2">Inmobiliaria</option><option value="3">Cliente</option><option value="4">Visitante</option></select><button class="btn btn-sm btn-primary">Asignar</button></form></td></tr><%}}}}catch(Exception e){%><tr><td colspan="5" class="text-danger">No fue posible consultar los usuarios.</td></tr><%}%></tbody></table></div></main><%@ include file="/WEB-INF/JSPF/inmo_footer.jspf" %></body></html>

